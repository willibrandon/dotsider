<starlight-theme-select data-theme="light">
	<button
		type="button"
		class="dotsider-theme-toggle"
		role="switch"
		aria-checked="false"
		aria-label="Switch to dark theme"
		title="Switch to dark theme"
	>
		<span class="track">
			<span class="glyph sun" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="currentColor">
					<path d="M5 12a1 1 0 0 0-1-1H3a1 1 0 0 0 0 2h1a1 1 0 0 0 1-1Zm.64 5-.71.71a1 1 0 0 0 0 1.41 1 1 0 0 0 1.41 0l.71-.71A1 1 0 0 0 5.64 17ZM12 5a1 1 0 0 0 1-1V3a1 1 0 0 0-2 0v1a1 1 0 0 0 1 1Zm5.66 2.34a1 1 0 0 0 .7-.29l.71-.71a1 1 0 1 0-1.41-1.41l-.66.71a1 1 0 0 0 0 1.41 1 1 0 0 0 .66.29Zm-12-.29a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.71-.71a1.004 1.004 0 1 0-1.43 1.41l.73.71ZM21 11h-1a1 1 0 0 0 0 2h1a1 1 0 0 0 0-2Zm-2.64 6A1 1 0 0 0 17 18.36l.71.71a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.76-.66ZM12 6.5a5.5 5.5 0 1 0 5.5 5.5A5.51 5.51 0 0 0 12 6.5Zm0 9a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Zm0 3.5a1 1 0 0 0-1 1v1a1 1 0 0 0 2 0v-1a1 1 0 0 0-1-1Z" />
				</svg>
			</span>
			<span class="glyph moon" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="currentColor">
					<path d="M21.64 13a1 1 0 0 0-1.05-.14 8.049 8.049 0 0 1-3.37.73 8.15 8.15 0 0 1-8.14-8.1 8.59 8.59 0 0 1 .25-2A1 1 0 0 0 8 2.36a10.14 10.14 0 1 0 14 11.69 1 1 0 0 0-.36-1.05Zm-9.5 6.69A8.14 8.14 0 0 1 7.08 5.22v.27a10.15 10.15 0 0 0 10.14 10.14 9.784 9.784 0 0 0 2.1-.22 8.11 8.11 0 0 1-7.18 4.32v-.04Z" />
				</svg>
			</span>
			<span class="thumb" aria-hidden="true">
				<span class="thumb-glow"></span>
			</span>
		</span>
	</button>
</starlight-theme-select>

<script is:inline>
	StarlightThemeProvider.updatePickers();
</script>

<script>
	class StarlightThemeSelect extends HTMLElement {
		constructor() {
			super();
			this.querySelector('button')?.addEventListener('click', () => {
				StarlightThemeProvider.toggleTheme();
			});
		}

		connectedCallback() {
			StarlightThemeProvider.updatePickers();
		}
	}

	if (!customElements.get('starlight-theme-select')) {
		customElements.define('starlight-theme-select', StarlightThemeSelect);
	}
</script>

<style>
	@layer starlight.components {
		starlight-theme-select {
			display: flex;
			align-items: center;
		}

		.dotsider-theme-toggle {
			--toggle-width: 2.95rem;
			--toggle-height: 1.7rem;
			--toggle-padding: 0.16rem;
			--thumb-size: calc(var(--toggle-height) - var(--toggle-padding) * 2);
			--thumb-travel: calc(var(--toggle-width) - var(--thumb-size) - var(--toggle-padding) * 2);
			position: relative;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: var(--toggle-width);
			height: var(--toggle-height);
			padding: 0;
			border-radius: 999px;
			border: 1px solid color-mix(in srgb, var(--sl-color-gray-3) 45%, transparent);
			background:
				linear-gradient(180deg, color-mix(in srgb, var(--sl-color-gray-5) 92%, white 8%), var(--sl-color-gray-6));
			box-shadow:
				inset 0 1px 0 rgba(255, 255, 255, 0.08),
				0 1px 2px rgba(0, 0, 0, 0.18);
			color: var(--sl-color-gray-2);
			cursor: pointer;
			transition:
				border-color 0.18s ease,
				background 0.18s ease,
				box-shadow 0.18s ease,
				color 0.18s ease;
		}

		.dotsider-theme-toggle:hover {
			border-color: color-mix(in srgb, var(--sl-color-accent) 32%, var(--sl-color-gray-3));
			color: var(--sl-color-white);
		}

		.dotsider-theme-toggle:focus-visible {
			outline: none;
			box-shadow:
				0 0 0 3px color-mix(in srgb, var(--sl-color-accent) 24%, transparent),
				inset 0 1px 0 rgba(255, 255, 255, 0.08);
		}

		.track {
			position: relative;
			display: block;
			width: 100%;
			height: 100%;
		}

		.glyph {
			position: absolute;
			top: 50%;
			width: 0.78rem;
			height: 0.78rem;
			transform: translateY(-50%);
			opacity: 0.72;
			transition:
				opacity 0.18s ease,
				color 0.18s ease,
				transform 0.18s ease;
		}

		.glyph svg {
			display: block;
			width: 100%;
			height: 100%;
		}

		.sun {
			left: 0.35rem;
		}

		.moon {
			right: 0.35rem;
		}

		.thumb {
			position: absolute;
			top: var(--toggle-padding);
			left: var(--toggle-padding);
			display: grid;
			place-items: center;
			width: var(--thumb-size);
			height: var(--thumb-size);
			border-radius: 999px;
			background:
				radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.72) 38%, rgba(255, 255, 255, 0.18) 100%),
				linear-gradient(180deg, color-mix(in srgb, var(--sl-color-white) 88%, var(--sl-color-accent) 12%), color-mix(in srgb, var(--sl-color-white) 68%, var(--sl-color-accent) 32%));
			box-shadow:
				0 0 0 1px rgba(255, 255, 255, 0.22),
				0 5px 14px rgba(0, 0, 0, 0.24);
			transform: translateX(0);
			transition:
				transform 0.24s cubic-bezier(0.32, 1.4, 0.64, 1),
				background 0.18s ease,
				box-shadow 0.18s ease;
		}

		.thumb-glow {
			width: 0.58rem;
			height: 0.58rem;
			border-radius: 999px;
			background: color-mix(in srgb, var(--sl-color-accent) 80%, white 20%);
			opacity: 0.78;
			filter: blur(0.15rem);
		}

		starlight-theme-select[data-theme='dark'] .dotsider-theme-toggle {
			background:
				linear-gradient(180deg, color-mix(in srgb, var(--sl-color-accent-low) 58%, black 42%), color-mix(in srgb, var(--sl-color-black) 82%, var(--sl-color-accent-low) 18%));
			border-color: color-mix(in srgb, var(--sl-color-accent) 40%, var(--sl-color-gray-4));
			color: var(--sl-color-accent-high);
		}

		starlight-theme-select[data-theme='dark'] .sun {
			opacity: 0.34;
			transform: translateY(-50%) scale(0.94);
		}

		starlight-theme-select[data-theme='dark'] .moon {
			opacity: 1;
			transform: translateY(-50%) scale(1.02);
		}

		starlight-theme-select[data-theme='dark'] .thumb {
			transform: translateX(var(--thumb-travel));
			background:
				radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.86), rgba(255, 255, 255, 0.12) 46%, rgba(0, 0, 0, 0) 52%),
				linear-gradient(180deg, color-mix(in srgb, var(--sl-color-accent) 34%, #c2d4ff), color-mix(in srgb, var(--sl-color-accent) 74%, #5b6f9e));
			box-shadow:
				0 0 0 1px rgba(186, 230, 253, 0.22),
				0 7px 18px rgba(3, 12, 20, 0.4);
		}

		starlight-theme-select[data-theme='dark'] .thumb-glow {
			background: color-mix(in srgb, var(--sl-color-accent-high) 58%, white 42%);
			opacity: 0.92;
		}

		starlight-theme-select[data-theme='light'] .sun {
			opacity: 1;
			transform: translateY(-50%) scale(1.02);
			color: color-mix(in srgb, var(--sl-color-accent) 48%, #d38a00);
		}

		starlight-theme-select[data-theme='light'] .moon {
			opacity: 0.38;
			transform: translateY(-50%) scale(0.94);
		}
	}
</style>
