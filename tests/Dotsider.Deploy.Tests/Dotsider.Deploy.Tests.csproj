<Project Sdk="MSTest.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSharedTestSources>false</IncludeSharedTestSources>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Dotsider.DeployHost/Dotsider.DeployHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../scripts/ScriptSupport.cs" Link="Scripts/ScriptSupport.cs" />
    <Compile Include="../../scripts/Deploy/*.cs" Link="Scripts/Deploy/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
