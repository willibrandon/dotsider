<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Dotsider.Mcp</RootNamespace>
    <AssemblyName>dotsider-mcp</AssemblyName>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <ToolPackageRuntimeIdentifiers>$(RuntimeIdentifiers);any</ToolPackageRuntimeIdentifiers>
    <IncludeSymbols>false</IncludeSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Speed</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <NativeDebugSymbols>true</NativeDebugSymbols>
    <StackTraceSupport>true</StackTraceSupport>
    <ControlFlowGuard Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-', System.StringComparison.Ordinal))">Guard</ControlFlowGuard>
    <DsymUtilOptions Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-', System.StringComparison.Ordinal))">$(DsymUtilOptions) &gt;/dev/null 2&gt;&amp;1</DsymUtilOptions>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotsider-mcp</ToolCommandName>
    <PackageId>Dotsider.Mcp</PackageId>
    <Version>0.24.4</Version>
    <Authors>willibrandon</Authors>
    <Description>MCP server for AI-assisted .NET assembly analysis with dotsider.</Description>
    <PackageTags>dotnet;assembly;mcp;ai;analysis;il;metadata</PackageTags>
    <PackageProjectUrl>https://github.com/willibrandon/dotsider</PackageProjectUrl>
    <RepositoryUrl>https://github.com/willibrandon/dotsider</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../assets/icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Dotsider.Core/Dotsider.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" IsAotCompatible="true" />
    <PackageReference Include="Microsoft.Extensions.Hosting" IsAotCompatible="true" />
  </ItemGroup>

</Project>
