<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <probing privatePath="lib" />

      <!-- Two requested versions (12.0.0.0 from OldDep, 13.0.0.0 from NewDep + EXE) collapse to 13.0.0.0. -->
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>

      <!-- Reachable via configured codeBase href; the file lives in external/.
           CodeBase requires a strong-named assembly identity (codeBase is honored only for
           strong-named binds), so this entry carries the publicKeyToken from CodeBaseLib.snk. -->
      <dependentAssembly>
        <assemblyIdentity name="NetFxBindingRedirects.CodeBaseLib" publicKeyToken="e061e779022b0ce6" culture="neutral" />
        <codeBase version="2.0.0.0" href="external/NetFxBindingRedirects.CodeBaseLib.dll" />
      </dependentAssembly>

      <!-- Deliberately broken: <codeBase> for an effective version that points at a missing file.
           The Bind_CodeBaseMissing fail-fast test asserts the binder reports CodeBaseMissing
           naming this href, not generic Unresolved. The publicKeyToken is fabricated so the
           identity is strong-named (codeBase requires that), and no such assembly exists. -->
      <dependentAssembly>
        <assemblyIdentity name="NetFxBindingRedirects.MissingCodeBase" publicKeyToken="0123456789abcdef" culture="neutral" />
        <codeBase version="9.9.9.9" href="external/Missing.dll" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
