<!-- FROZEN TEST FIXTURE — do not modify without updating Dotsider.Tests -->
<!-- Output is copied to the root EXE's bin/.../lib/ subdirectory (probing privatePath="lib"). -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>NetFxBindingRedirects.PrivatePathLib</RootNamespace>
    <AssemblyName>NetFxBindingRedirects.PrivatePathLib</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>
</Project>
