<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Speed</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <NativeDebugSymbols>false</NativeDebugSymbols>
    <IncludeSharedTestSources>false</IncludeSharedTestSources>
    <IncludeDotsiderTraceHostInOutput>true</IncludeDotsiderTraceHostInOutput>
    <IncludeDotsiderTraceHostInPublish>true</IncludeDotsiderTraceHostInPublish>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Dotsider.Core/Dotsider.Core.csproj" />
  </ItemGroup>

  <Import Project="../../build/Dotsider.TraceHost.targets" />

</Project>
