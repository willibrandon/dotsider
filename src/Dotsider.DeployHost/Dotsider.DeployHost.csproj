<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>dotsider-deploy-host</AssemblyName>
    <RootNamespace>Dotsider.DeployHost</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dotsider.Deploy.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../deploy/install-manifest.json"
                      LogicalName="Dotsider.DeployHost.install-manifest.json" />
    <EmbeddedResource Include="../../deploy/Caddyfile;../../deploy/*.yml;../../deploy/*.service;../../deploy/*.timer;../../deploy/caddy-metrics-logrotate">
      <LogicalName>Dotsider.DeployHost.Assets.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
