<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Pin the runtime to CLR 2.0 explicitly so the runtime oracle activates v2.0.50727 even on
       hosts where .NET 4.x is also installed. Without this, mscoree shims net35 EXEs up to CLR4,
       which would defeat the test's intent. -->
  <startup>
    <supportedRuntime version="v2.0.50727" sku=".NETFramework,Version=v3.5" />
  </startup>
  <runtime>
    <!-- Empty appliesTo applies to every CLR — host the codeBase entries and probing privatePath
         here so they're visible to the binder regardless of which CLR sees this config. -->
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <probing privatePath="lib" />

      <!-- Reachable via configured codeBase href; the file lives in external/. -->
      <dependentAssembly>
        <assemblyIdentity name="NetFxBindingRedirects.Clr2.CodeBaseLib" publicKeyToken="d4a9fecb5ef90905" culture="neutral" />
        <codeBase version="2.0.0.0" href="external/NetFxBindingRedirects.Clr2.CodeBaseLib.dll" />
      </dependentAssembly>

      <!-- Deliberately broken: <codeBase> for an effective version that points at a missing file.
           The fail-fast test asserts the binder reports CodeBaseMissing naming this href, not
           generic Unresolved. The publicKeyToken is fabricated so the identity is strong-named
           (codeBase requires that), and no such assembly exists. -->
      <dependentAssembly>
        <assemblyIdentity name="NetFxBindingRedirects.Clr2.MissingCodeBase" publicKeyToken="0123456789abcdef" culture="neutral" />
        <codeBase version="9.9.9.9" href="external/Missing.dll" />
      </dependentAssembly>
    </assemblyBinding>

    <!-- Canonical CLR 2 form: appliesTo="v2.0.50727" — the version SharedDep redirects live in. -->
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1" appliesTo="v2.0.50727">
      <dependentAssembly>
        <assemblyIdentity name="NetFxBindingRedirects.Clr2.SharedDep" publicKeyToken="e89d2d22dd26920d" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.0.0.0" newVersion="2.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>

    <!-- Short form CLR 2: must be honored. Carries a harmless redirect on a non-existent identity
         so the test can assert the parser kept this block. -->
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1" appliesTo="v2">
      <dependentAssembly>
        <assemblyIdentity name="Clr2.AppliesToShort.V2" publicKeyToken="2222222222222222" culture="neutral" />
        <bindingRedirect oldVersion="1.0.0.0" newVersion="2.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>

    <!-- v2.0 form: also honored. -->
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1" appliesTo="v2.0">
      <dependentAssembly>
        <assemblyIdentity name="Clr2.AppliesToShort.V20" publicKeyToken="2020202020202020" culture="neutral" />
        <bindingRedirect oldVersion="1.0.0.0" newVersion="2.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>

    <!-- POISON: a v4-only block that the test asserts is NOT applied to a Clr2 context. The
         9.9.9.9 redirect would point SharedDep at a non-existent version if it leaked through. -->
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1" appliesTo="v4.0.30319">
      <dependentAssembly>
        <assemblyIdentity name="NetFxBindingRedirects.Clr2.SharedDep" publicKeyToken="e89d2d22dd26920d" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.0.0.0" newVersion="9.9.9.9" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
